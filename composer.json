{
  "name": "estatein/theme",
  "description": "Custom Estatein WordPress theme",
  "type": "wordpress-theme",
  "license": "GPL-2.0-or-later",
  "require": { "php": ">=8.2" },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "squizlabs/php_codesniffer": "^3.13",
    "wp-coding-standards/wpcs": "^3.2",
    "phpcompatibility/phpcompatibility-wp": "^2.1"
  },
  "autoload": { "psr-4": { "Estatein\\Theme\\": "app/" } },
  "scripts": {
    "lint": "phpcs",
    "analyse": "phpstan analyse"
  },
  "config": { "allow-plugins": { "dealerdirect/phpcodesniffer-composer-installer": true }, "sort-packages": true }
}

