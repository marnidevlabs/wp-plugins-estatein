{
  "name": "estatein-theme",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint assets/src/js/**/*.js",
    "lint:css": "stylelint assets/src/css/**/*.css",
    "build": "npm run lint",
    "format": "prettier --write assets/src/**/*.{css,js}"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "eslint": "^9.33.0",
    "prettier": "^3.6.2",
    "stylelint": "^16.23.1",
    "stylelint-config-standard": "^39.0.0"
  }
}

